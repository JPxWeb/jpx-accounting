ACCOUNTING_RUNTIME_MODE=demo
# Comma-separated browser origins allowed to call the API directly when runtime mode is `normal` (ignored in `demo`, which uses open CORS).
ACCOUNTING_CORS_ORIGINS=
# E2E / local only: lets POST /api/testing/reset in demo erase the in-memory store (never enable in deployed normal mode).
# ALLOW_TEST_RESET=true
NEXT_PUBLIC_ACCOUNTING_RUNTIME_MODE=demo
ACCOUNTING_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=/api-proxy
NEXT_PUBLIC_DISABLE_SW=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5-mini
# Signs advisor tool-approval round trips (AI SDK toolApproval). A demo default
# exists in code; deployed normal mode MUST set its own secret.
ADVISOR_TOOL_APPROVAL_SECRET=
# --- Database (provider-neutral; ledger persistence) ------------------------
# Runtime connection string (direct, session-pooler, or transaction-pooler) - required to enable
# PostgresLedgerStore in normal mode. Works with Supabase, Azure Database for PostgreSQL, Neon, or
# any PostgreSQL 15-17 + pgvector-compatible provider. TLS is configured via standard URL params
# (e.g. ?sslmode=verify-full) - there is no separate TLS variable.
DATABASE_URL=
# Owner/migrator connection string (direct or session connectivity), used ONLY by the migration
# runner (scripts/db-migrations.mts) - never read by the running API process itself. Falls back to
# DATABASE_URL when unset and DATABASE_POOL_MODE is direct|session (never in transaction mode).
DATABASE_MIGRATION_URL=
# direct|session|transaction. Set to "transaction" when DATABASE_URL points at a transaction-mode
# pooler (e.g. Supabase Supavisor port 6543) - disables postgres-js prepared statements, which
# transaction-mode poolers do not support. Default: direct.
DATABASE_POOL_MODE=direct
# Bounded total runtime connection pool size. Default: 10.
DATABASE_POOL_MAX=10
# Explicit, disposable external test database URL (name MUST start with jpx_test_) for strict
# integration tests against a non-local provider. Never reused for anything but throwaway test
# data, and never a substitute for DATABASE_URL.
DATABASE_TEST_URL=
# --- Legacy Supabase database aliases (deprecated; use the DATABASE_* vars above) ---------------
# SUPABASE_DB_URL is a deprecated alias for DATABASE_URL. SUPABASE_POOLER_TRANSACTION_MODE=true is
# a deprecated alias for DATABASE_POOL_MODE=transaction. Both are still accepted during the
# migration window. Setting BOTH the canonical and legacy form to conflicting values fails fast at
# boot, before any connection attempt; setting only one (or both to the identical value) works
# normally. New setups should use only the canonical DATABASE_* vars above.
SUPABASE_DB_URL=
SUPABASE_POOLER_TRANSACTION_MODE=false
# --- Supabase Auth (JWKS API verification, WS-C R12) -------------------------
# When set, ALL /api/* routes (GET /api/runtime-info excepted) require a JWT verifiable against this
# JWKS endpoint. REQUIRED in normal mode - the API refuses to boot without it (fail closed).
# Typical Supabase value: ${SUPABASE_URL}/auth/v1/keys. Optional in demo mode.
SUPABASE_JWKS_URL=
# --- Supabase Auth (browser, WS-C R12) --------------------------------------
# Project URL + publishable anon key for the web app's Supabase Auth client (sign-in/sign-up UI,
# Authorization bearer threading). BOTH must be set at web BUILD time to enable the auth UI -
# leave unset for the auth-free demo experience (login/account affordances hide themselves).
# The URL's origin is also added to the web CSP connect-src.
NEXT_PUBLIC_SUPABASE_URL=
# The anon (publishable) key - safe for browsers by design; row access is enforced server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, comma-separated: asymmetric algorithms the JWKS verifier accepts (e.g. RS256,ES256).
# Defaults to RS256,ES256 when unset - Supabase's newer projects sign with ES256, so a bare RS256
# allowlist would 401 every legitimate user on those projects.
SUPABASE_JWT_ALGS=
# --- Azure Storage (evidence blobs) -----------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=evidence
# Local self-host fallback (D1): when set, ACCOUNTING_BLOB_DIR takes precedence over an
# unconfigured Azure Storage (but Azure, when both are set, always wins). Evidence bytes are
# stored under this directory using the SAME evidence-uploads/{id}/{filename} path convention as
# Azure, so a later bulk upload to Azure Blob needs no event-history rewrite. See docs/SELF_HOST.md.
ACCOUNTING_BLOB_DIR=
# Web CSP allowance for direct-to-Azure SAS traffic (browser PUTs via connect-src, read-SAS previews via img-src/frame-src).
# Set to the storage origin, e.g. https://<account>.blob.core.windows.net - must be present at web BUILD time. Unset keeps the strict same-origin CSP (demo/stub uploads).
NEXT_PUBLIC_AZURE_STORAGE_ORIGIN=
# --- Azure Document Intelligence (OCR for receipts/invoices) ----------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# --- Observability (WS-A5) ---------------------------------------------------
# API telemetry: Bicep injects this into the deployed API App Service; leave unset locally -
# services/api/src/telemetry.ts is a strict no-op without it (no SDK load, no overhead).
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Browser telemetry seam (apps/web/lib/telemetry.ts) - currently a documented no-op; enabling it
# also needs the App Insights ingestion origin added to the web CSP connect-src (next.config.ts).
# NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=